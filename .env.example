# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=iotmart
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iotmart

# ─── FastAPI Backend ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://iotmart:changeme@localhost:5432/iotmart
SECRET_KEY=change-this-to-a-random-32-char-secret
DEBUG=false
ENVIRONMENT=production

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to use console/log output instead (development mode).
# The OTP will be printed to the backend stdout — useful for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@iotmart.com
# SMTP_USE_TLS=false        # Set true for SMTP_SSL on port 465
# SMTP_TLS_STARTTLS=true    # Set true for STARTTLS on port 587

# Example for Gmail App Passwords:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@gmail.com

# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# ─── OTP settings ─────────────────────────────────────────────────────────────
# OTP_EXPIRE_MINUTES=5      # How long the code is valid (default: 5)
# OTP_MAX_ATTEMPTS=5        # Failed attempts before the code is locked (default: 5)

# ─── Next.js Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=IoTMart
NEXT_PUBLIC_SITE_DESCRIPTION=Your one-stop shop for IoT gadgets, sensors, and development boards
